# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://studygotchi:studygotchi@localhost:5432/studygotchi

# LLM provider (structured extraction + vision)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Embeddings (Voyage AI is Anthropic's recommended embeddings partner)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3

# Set to "fake" to use the deterministic offline LLM stub instead of Anthropic/Voyage
LLM_PROVIDER=anthropic

ENVIRONMENT=development
