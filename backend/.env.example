# Local SQLite file committed to the repo (demo scale, no server to run).
# Leave unset to use the default: backend/studygotchi.db
# DATABASE_URL=sqlite+aiosqlite:///./studygotchi.db
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
ENVIRONMENT=development
# Optional legacy provider: LLM_PROVIDER=anthropic, ANTHROPIC_API_KEY, VOYAGE_API_KEY
# Offline tests inject FakeLLMProvider; it does not fabricate live extractions.
