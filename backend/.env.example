# Leave unset for the local SQLite file (backend/studygotchi.db).
# Production: the Neon pooled string, e.g. postgresql+asyncpg://...?ssl=require
# DATABASE_URL=

# openai | fake. Offline tests inject the fake provider; it never fabricates live extractions.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=1024

# Browser origins allowed to call this API, comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# clerk: verify bearer JWTs. dev: trust an X-Student-Id header (never in production)
AUTH_MODE=dev
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Parallel model calls per file, and the absolute cosine floor for fast-phase matches
INGEST_CONCURRENCY=4
MATCH_THRESHOLD=0.35

ENVIRONMENT=development
