# Postgres (matches docker-compose.yml defaults; on Neon use the pooled string with ?ssl=require)
DATABASE_URL=postgresql+asyncpg://studygotchi:studygotchi@localhost:5432/studygotchi

# openai | anthropic | fake. Tonight we use OpenAI for extraction, vision, and embeddings.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMENSIONS=1024

# Unused unless LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3

# Browser origins allowed to call this API, comma-separated
CORS_ORIGINS=http://localhost:3000

# clerk: verify bearer JWTs. dev: trust an X-Student-Id header (never in production)
AUTH_MODE=dev
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Parallel model calls per file, and the absolute cosine floor for fast-phase matches
INGEST_CONCURRENCY=6
MATCH_THRESHOLD=0.35

ENVIRONMENT=development
