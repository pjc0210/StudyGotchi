# Postgres (matches docker-compose.yml defaults; on Neon use the pooled string with ?ssl=require)
DATABASE_URL=postgresql+asyncpg://studygotchi:studygotchi@localhost:5432/studygotchi

# Extraction models: the strong one reads course material once, the fast one reads student files
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Embeddings (1024 dimensions; the schema depends on it)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3

# Set to "fake" to use the deterministic offline stub instead of Anthropic/Voyage
LLM_PROVIDER=anthropic

# Browser origins allowed to call this API, comma-separated
CORS_ORIGINS=http://localhost:3000

# clerk: verify bearer JWTs. dev: trust an X-Student-Id header (never in production)
AUTH_MODE=dev
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Parallel model calls per file, and the absolute cosine floor for fast-phase matches
INGEST_CONCURRENCY=6
MATCH_THRESHOLD=0.35

ENVIRONMENT=development
