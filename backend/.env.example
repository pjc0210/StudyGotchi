# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://studygotchi:studygotchi@localhost:5432/studygotchi

# LLM provider: openai | anthropic | fake
LLM_PROVIDER=openai

# OpenAI (structured extraction + embeddings + vision)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_EMBED_MODEL=text-embedding-3-large
# Must match Vector(1024) / EMBEDDING_DIM in app.db.models
OPENAI_EMBED_DIMENSIONS=1024

# Anthropic (structured extraction + vision) — used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# Embeddings (Voyage AI is Anthropic's recommended embeddings partner)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3

ENVIRONMENT=development
