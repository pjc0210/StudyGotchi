{
  "$schema": "studygotchi-tokens/normalized-v1",
  "name": "StudyGotchi \u00b7 Toybox Low-Poly",
  "generated_from": "tokens.export.json (Claude Design export, 2026-09-19), normalised by the Intake worker; charter-only entries come from .fleet/org.md",
  "conventions": "flat kebab-case keys per group; colours lowercase hex or rgba(); lengths are px numbers; durations are ms numbers; line heights are unitless",
  "color": {
    "sky": "#f3e4ee",
    "cream": "#fffaf3",
    "cream-glass": "rgba(255, 250, 243, 0.78)",
    "ink": "#3a2f45",
    "ink-muted": "#6b5f78",
    "ink-faint": "#e9dce6",
    "ink-disabled": "#b9a9b8",
    "forest-ground": "#8fc48a",
    "forest-ground-light": "#b4dab0",
    "forest-ground-shade": "#6ea369",
    "forest-accent": "#4f8a4a",
    "forest-accent-light": "#79ab74",
    "forest-accent-shade": "#3a6b36",
    "city-ground": "#d9c3d6",
    "city-ground-light": "#ece0ea",
    "city-ground-shade": "#bda5ba",
    "city-accent": "#b98bb0",
    "city-accent-light": "#d0adc8",
    "city-accent-shade": "#986e90",
    "ice-ground": "#e6f2fb",
    "ice-ground-light": "#f6fafd",
    "ice-ground-shade": "#c7dcec",
    "ice-accent": "#a9cfe8",
    "ice-accent-light": "#c6e1f1",
    "ice-accent-shade": "#86b2cf",
    "sand-ground": "#efd9a2",
    "sand-ground-light": "#f6e8c2",
    "sand-ground-shade": "#d5bc7e",
    "sand-accent": "#d2a95e",
    "sand-accent-light": "#e0c184",
    "sand-accent-shade": "#b08a45",
    "meadow-ground": "#bfe0a0",
    "meadow-ground-light": "#d6ecc2",
    "meadow-ground-shade": "#9fc47f",
    "meadow-accent": "#8fbf6a",
    "meadow-accent-light": "#aed08e",
    "meadow-accent-shade": "#6f9d4f",
    "creature-peach": "#f2a86f",
    "creature-coral": "#e88a8a",
    "creature-mint": "#8fc9d8",
    "creature-olive": "#b9c96f",
    "creature-lilac": "#c9a2e6",
    "state-touched": "#bfe0a0",
    "state-touched-dot": "#4f8a4a",
    "state-demonstrated": "#f2a86f",
    "state-demonstrated-dot": "#d2a95e",
    "state-creature": "#c9a2e6",
    "state-creature-dot": "#b98bb0",
    "state-visiting": "#a9cfe8",
    "state-error": "#e88a8a",
    "state-error-text": "#b34a4a",
    "state-focus": "#4f8a4a",
    "shadow-tint": "#5a3f6b"
  },
  "font": {
    "family-sans": "'Nunito', 'SF Pro Rounded', ui-rounded, system-ui, sans-serif",
    "weight-body": 500,
    "weight-subhead": 700,
    "weight-head": 800
  },
  "text": {
    "display": {
      "size": 56,
      "line-height": 1.05,
      "weight": 800,
      "letter-spacing": "-0.01em"
    },
    "h1": {
      "size": 40,
      "line-height": 1.1,
      "weight": 800
    },
    "h2": {
      "size": 28,
      "line-height": 1.2,
      "weight": 800
    },
    "h3": {
      "size": 22,
      "line-height": 1.25,
      "weight": 700
    },
    "body": {
      "size": 17,
      "line-height": 1.5,
      "weight": 500
    },
    "caption": {
      "size": 14,
      "line-height": 1.45,
      "weight": 500
    },
    "label": {
      "size": 13,
      "line-height": 1.3,
      "weight": 800,
      "letter-spacing": "0.12em",
      "text-transform": "uppercase"
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48,
    "16": 64,
    "hud-inset": 24
  },
  "radius": {
    "sm": 12,
    "md": 16,
    "lg": 24,
    "pill": 999
  },
  "border-width": {
    "sticker": 3,
    "icon-stroke": 2.5,
    "ring-stroke": 6
  },
  "shadow": {
    "rest": "0 6px 16px rgba(90, 63, 107, 0.12)",
    "raised": "0 12px 28px rgba(90, 63, 107, 0.16)",
    "sticker-drop": "0 3px 0 #3a2f45"
  },
  "blur": {
    "glass": 12
  },
  "duration": {
    "hover": 120,
    "close": 200,
    "appear": 320,
    "panel": 360,
    "max": 400,
    "bob": 2400
  },
  "ease": {
    "out": "cubic-bezier(0.2, 0, 0, 1)",
    "overshoot": "cubic-bezier(0.2, 1.4, 0.4, 1)",
    "overshoot-soft": "cubic-bezier(0.2, 1.2, 0.4, 1)"
  },
  "keyframes": {
    "pop": {
      "0%": "scale(0.6) / opacity 0",
      "60%": "scale(1.08) / opacity 1",
      "100%": "scale(1)"
    },
    "slide-up": {
      "0%": "translateY(24px) / opacity 0",
      "70%": "translateY(-3px) / opacity 1",
      "100%": "translateY(0)"
    },
    "bob": {
      "0%": "translateY(0)",
      "50%": "translateY(-6px)",
      "100%": "translateY(0)"
    }
  },
  "size": {
    "touch-min": 44,
    "button": 48,
    "chip": 36,
    "badge": 32
  },
  "charter-only": {
    "note": "in .fleet/org.md but absent from the Claude Design export; light/shade ramps not defined yet",
    "color": {
      "ocean-ground": "#9fd3e0",
      "ocean-accent": "#4f8fb0",
      "volcanic-ground": "#c9a08f",
      "volcanic-accent": "#8a4a3f"
    }
  }
}